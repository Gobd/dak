# Launch the manager in print mode. The prompt is appended as one final argument.
# Flags before pi belong to lambdap. Flags after pi belong to Pi.
REX_MANAGER_COMMAND_JSON='["lambdap","--self-contained","--no-mcp","pi","--print","--no-session","--no-tools","--no-extensions","--no-mcp","--no-skills","--no-prompt-templates","--no-context-files"]'
# Loopback by default. Use your Mac’s LAN IP when serving HTTPS directly.
REX_HOST=127.0.0.1
REX_PORT=5184
# REX_TLS_CERT=/absolute/path/to/fullchain.pem
# REX_TLS_KEY=/absolute/path/to/privkey.pem
# Allowed frontend origins. Add an exact Cloudflare preview origin if needed.
REX_ALLOWED_ORIGINS=https://dak.bkemper.me,http://localhost:5183

# Folder picker and session launches stay within this directory.
REX_PROJECT_ROOT=~/Developer

# Optional cmux executable/socket overrides (default executable: cmux on PATH).
# CMUX_BIN=/absolute/path/to/cmux
# CMUX_SOCKET_PATH=/Users/you/.local/state/cmux/cmux.sock
# CMUX_SOCKET_PASSWORD=your-local-socket-password

# Optional executable override for the same project history used by zi.
# REX_ZOXIDE_BIN=/opt/homebrew/bin/zoxide

# Noninteractive harness commands for scheduled prompts (paths relative to rex).
REX_TASK_HARNESSES_FILE=task-harnesses.local.json
REX_TASKS_FILE=scheduled-tasks.local.json

# Optional push: each task can specify an ntfy topic. Token stays on the Mac.
REX_NTFY_URL=https://ntfy.sh
# REX_NTFY_TOKEN=tk_your_access_token
