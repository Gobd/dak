# Copy this file to secrets.yaml (same folder) and fill in real values.
# secrets.yaml is gitignored - never commit it.

wifi_ssid: "YourWifiName"
wifi_password: "YourWifiPassword"

# Random 32-byte base64 key for the ESPHome native API (used for OTA/logs over WiFi).
# Generate one with: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_GENERATED_KEY"
